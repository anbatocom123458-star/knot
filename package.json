{
  "name": "knot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KNOT — pixel-art platformer (PC browser & mobile).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "map:smoke": "node scripts/map-smoke.mjs",
    "server": "node server/index.js",
    "start": "npm run build && npm run server"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
